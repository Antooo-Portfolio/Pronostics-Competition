# Configuration de développement / production pour le serveur Express
PORT=3001

# URL de connexion PostgreSQL (Supabase, Neon, ou local)
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@localhost:5432/worldcup_db

# Clé secrète pour la signature des jetons JWT
JWT_SECRET=votre_cle_secrete_jwt_super_robuste_ici

# Clé API football-data.org (optionnel, pour sync calendrier officiel)
API_KEY=votre_cle_api_football_data_org

# Date de début du tournoi (ISO 8601)
TOURNAMENT_START_DATE=2026-06-11T20:00:00Z

# URL autorisée CORS (optionnel)
CLIENT_URL=https://portfolio.antonyrodrigues.fr
